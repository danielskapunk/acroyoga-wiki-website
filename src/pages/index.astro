---
import Search from 'astro-pagefind/components/Search.astro'
import { getCollection } from 'astro:content'
import FilterBar from '../components/FilterBar.astro'
import Mosaic from '../components/Mosaic.astro'
import Layout from '../layouts/Layout.astro'
const allAcro = await getCollection('acro')
// Keep the legacy filename order (Content Layer sorts by entry id instead)
allAcro.sort((a, b) => {
	const x = String(a.filePath)
	const y = String(b.filePath)
	return x < y ? -1 : x > y ? 1 : 0
})
---

<Layout title="Acroyoga Wiki">
	<Search instance="search" className="pagefind-search grey px-2 py-4" />
	<FilterBar />

	<main>
		<Mosaic items={allAcro} />
	</main>
</Layout>

<style is:global>
	nav {
		display: grid;
		place-items: center;
	}

	/* Pagefind Component UI theme (astro-pagefind v2) */
	.pagefind-search {
		--pf-background: rgb(180, 180, 180);
		--pf-hover: rgb(200, 200, 200);
		--pf-border: slategrey;
		--pf-border-radius: 0.3rem;
		--pf-font: sans-serif;
		--pf-input-height: 32px;
		--pf-input-font-size: 14px;
		--pf-searchbox-max-width: 100%;
	}
</style>
