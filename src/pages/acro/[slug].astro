---
import { YouTube } from '@astro-community/astro-embed-youtube'
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import InfoSection from '../../components/InfoSection.astro'
import Transition from '../../components/Transition.astro'
import Layout from '../../layouts/Layout.astro'
import { buildTransitionContext } from '../../lib/transitions'

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
	const acroEntries = await getCollection('acro')
	acroEntries.forEach((entry) => {
		if (entry.data.image.width < 600) {
			throw new Error(
				`Cover image must be at least 600 pixels wide! (${entry.id}: ${entry.data.image.src})`
			)
		}
	})
	return acroEntries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry }
	}))
}
const { entry } = Astro.props
const { Content } = await render(entry)
const ctx = await buildTransitionContext()
const into = entry.data.transitions.filter((t) => t.direction === 'in' || t.direction === 'both')
const from = entry.data.transitions.filter((t) => t.direction === 'out' || t.direction === 'both')
const currentLabel =
	entry.data.shortName && entry.data.shortName.trim() ? entry.data.shortName : entry.data.name
var params = ''
try {
	let url = new URL(entry.data.video || '')
	let _s = url.searchParams.get('t') || url.searchParams.get('start') || ''
	_s = _s?.replace('s', '')
	params = _s ? `start=${_s}` : ''
} catch {}
---

<Layout title={entry.data.name}>
	<article class="bg-gray-300 pb-4">
		<h1 class="text-center font-display font-bold">{entry.data.name}</h1>

		<Image class="h-96 w-full object-cover" src={entry.data.image} alt="imagen del truco" />

		<InfoSection data={entry} />

		<section class="space-y-4 px-4 sm:px-6">
			{
				into.length > 0 && (
					<Transition
						title={`Transiciones hacia ${entry.data.name}`}
						mode="in"
						current={currentLabel}
						data={into}
						ctx={ctx}
						idPrefix={entry.id}
					/>
				)
			}
			{
				from.length > 0 && (
					<Transition
						title={`Transiciones desde ${entry.data.name}`}
						mode="out"
						current={currentLabel}
						data={from}
						ctx={ctx}
						idPrefix={entry.id}
					/>
				)
			}

			<h3>Imagen</h3>
			<Image
				class="mx-auto block h-auto max-h-96 w-auto"
				src={entry.data.image}
				alt="imagen del truco"
			/>

			{
				entry.data.video ? (
					<>
						<h3>Video</h3>
						<YouTube
							class="mx-auto block h-auto max-h-96 w-auto"
							id={entry.data.video}
							params={params}
						/>
					</>
				) : (
					<p>Sin video</p>
				)
			}

			<Content />
		</section>
	</article>
</Layout>

<style is:global>
	.seq {
		min-width: 0;
	}
	.seq p {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
	}
	.seq img {
		object-fit: cover;
		height: revert-layer;
	}
	.variantes ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		background: rgb(0, 0, 0, 78%);
		padding: 30px 10px;
		border-radius: 13px;
	}
	.variantes em {
		position: absolute;
		margin-top: -30px;
		margin-left: 10px;
		background: rgba(255, 255, 255, 40%);
		padding: 2px 7px;
	}
	.variantes li {
		width: 250px;
		height: 250px;
	}
	.variantes li p {
		height: 100%;
	}

	.variantes img {
		object-fit: cover;
		height: 100%;
		vertical-align: middle;
		border-radius: 5px;
	}
</style>
