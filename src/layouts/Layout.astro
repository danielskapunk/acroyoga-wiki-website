---
import '../styles/global.css'

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/ojos.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<main class="mx-auto my-0 max-w-5xl">
			<slot />
		</main>
	</body>
</html>
<style is:global>
	@font-face {
		font-family: 'Montserrat';
		src: url('/fonts/Montserrat-Regular.ttf') format('truetype');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--black: 27, 28,
			29 --accent-gradient:
				linear-gradient(45deg, rgb(var(--accent)), rgb(var(--accent-light)) 30%, white 60%);
		--blue: #2563eb;
	}

	a {
		font-size: medium;
		color: var(--blue);
		/* text-blue-600 dark:text-blue-500 hover:underline */
	}
	a:hover {
		text-decoration: underline;
	}
	html {
		color: rgb(var(--black));
		font-family: 'Montserrat', system-ui, sans-serif !important;
		background: #0f0f10;
		background-size: 224px;
	}
	code {
		font-family:
			Montserrat,
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	h1,
	h2,
	h3,
	h4 {
		padding-top: 1rem;
		margin-bottom: 0.75rem;
		font-weight: 700;
		text-wrap: balance;
	}
	h1 {
		font-size: clamp(1.5rem, 1rem + 3vw, 2.25rem);
		line-height: 1.15;
	}
	h2,
	h3,
	h4 {
		font-size: clamp(1.125rem, 1rem + 1vw, 1.375rem);
	}

	a[href^='http'] {
		color: var(--blue);
		text-decoration-line: underline;
		text-decoration-style: dotted;
		text-underline-offset: 3px;
	}
	a[href^='http']:hover {
		text-decoration-style: solid;
	}

	.btn-video {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 0.375rem;
		border: 1px solid rgb(156 163 175 / 0.6);
		padding: 0.4rem 1rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: rgb(75 85 99);
		text-decoration: none;
	}
	.btn-video:hover {
		border-color: rgb(107 114 128);
		color: rgb(55 65 81);
		text-decoration: none;
	}
</style>
