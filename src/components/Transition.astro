---
import { Icon } from 'astro-icon/components'
import type { TransitionContext } from '../lib/transitions'

interface TransitionEntry {
	name: string
	aka: string[]
	pose: string
	direction: 'in' | 'out' | 'both'
	slug?: string
	video?: string
}

interface Props {
	title: string
	mode: 'in' | 'out'
	current: string
	data: TransitionEntry[]
	ctx: TransitionContext
}

const { title, mode, current, data, ctx } = Astro.props
---

<section>
	<h3>{title}</h3>
	<ul
		class="grid grid-cols-[minmax(0,auto)_24px_minmax(0,auto)_24px_minmax(0,1fr)_44px] items-center gap-x-1.5 gap-y-2 sm:grid-cols-[auto_60px_auto_60px_1fr_44px] sm:gap-x-2"
	>
		{
			data.map((t) => {
				const pose = ctx.poseInfo(t.pose)
				const transition = ctx.transitionInfo(t)
				const source = mode === 'in' ? pose : { label: current, href: null }
				const dest = mode === 'in' ? { label: current, href: null } : pose
				return (
					<li class="contents">
						{source.href ? (
							<a href={source.href} class="min-w-0 break-words text-right">
								{source.label}
							</a>
						) : (
							<span class="min-w-0 break-words text-right">{source.label}</span>
						)}

						<span class="flex justify-center text-gray-500" aria-hidden="true">
							<Icon name="fa:chevron-right" class="h-3 w-auto" />
						</span>

						{transition.href ? (
							<a href={transition.href} class="min-w-0 break-words text-center">
								{transition.label}
							</a>
						) : (
							<span class="min-w-0 break-words text-center">{transition.label}</span>
						)}

						<span class="flex justify-center text-gray-500" aria-hidden="true">
							<Icon name="fa:chevron-right" class="h-3 w-auto" />
						</span>

						{dest.href ? (
							<a href={dest.href} class="min-w-0 break-words">
								{dest.label}
							</a>
						) : (
							<span class="min-w-0 break-words">{dest.label}</span>
						)}

						{t.video ? (
							<a
								href={t.video}
								class="flex h-7 w-7 items-center justify-center rounded-md border border-gray-400/60 bg-transparent text-gray-400/60 hover:border-gray-500 hover:text-gray-500"
								aria-label={`Video: ${transition.label}`}
								title={transition.label}
							>
								<Icon name="fa:play" class="h-3 w-auto" />
							</a>
						) : (
							<span class="block" />
						)}
					</li>
				)
			})
		}
	</ul>
</section>
